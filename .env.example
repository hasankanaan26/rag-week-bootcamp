# ============================================================
# Environment Variables for Week 3: RAG Done Properly
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Provider selector ---
# Set to "gemini" to use Google AI Studio, or "azure" to use Azure OpenAI
LLM_PROVIDER=gemini

# --- Gemini Settings (used when LLM_PROVIDER=gemini) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Azure OpenAI Settings (used when LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# --- Embedding Settings (Session 3+) ---
GEMINI_EMBEDDING_MODEL=text-embedding-004
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# --- Vector Store Settings (Session 3+) ---
CHROMA_PATH=./chroma_data

# --- Data Settings ---
# Path to the knowledge base folder (relative to project root)
KNOWLEDGE_DIR=data/knowledge

# --- Chunking Settings (Session 2+) ---
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
