# ============================================================
# Environment Variables for Week 3: RAG Done Properly
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Provider selector ---
# Set to "gemini" to use Google AI Studio, or "azure" to use Azure OpenAI
LLM_PROVIDER=gemini

# --- Gemini Settings (used when LLM_PROVIDER=gemini) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Azure OpenAI Settings (used when LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# --- Embedding Settings (Checkpoint 2+) ---
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# "gemini", "azure", or "ollama" (defaults to LLM_PROVIDER)
# ollama = free local embeddings, see docs/local-embeddings.md
# After switching, re-ingest with POST /ingest?fresh=true
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Vector Store Settings (Checkpoint 2+) ---
# "chroma" (local files in CHROMA_PATH) or "postgres" (pgvector in Docker)
VECTOR_STORE=chroma
CHROMA_PATH=./chroma_data
# Start the database with: docker compose up -d pgvector
DATABASE_URL=postgresql://rag:rag@localhost:5434/rag_bootcamp

# --- Data Settings ---
# Path to the knowledge base folder (relative to project root)
KNOWLEDGE_DIR=data/knowledge

# --- Chunking Settings (Checkpoint 1+) ---
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
